s\" v-if=\"tabList.list == ''\">\n            暂无照片，请添加~\n          </div>\n          <el-carousel\n            ref=\"carousel\"\n            :interval=\"4000\"\n            :autoplay=\"true\"\n            trigger=\"click\"\n            height=\"550px\"\n            @change=\"swiperChange\"\n          >\n            <el-carousel-item\n              v-for=\"(item, index) in tabList.list\"\n              :key=\"index\"\n            >\n              <img class=\"cate-pic\" :src=\"item.img\" />\n            </el-carousel-item>\n          </el-carousel>\n        </div>\n      </Col>\n      <Col>\n        <div :class=\"name != 'admin_login_slide' ? 'content' : 'contents'\">\n          <div class=\"right-box\">\n            <div class=\"hot_imgs\">\n              <div class=\"title\">引导页设置</div>\n              <div class=\"title-text\">\n                建议尺寸：750 * 1334px，拖拽图片可调整图片顺序哦，最多添加五张\n              </div>\n              <div class=\"list-box\">\n                <div>\n                  <Form :model=\"formItem\" :label-width=\"80\">\n                    <FormItem label=\"开屏广告:\">\n                      <i-switch\n                        v-model=\"formItem.status\"\n                        :true-value=\"1\"\n                        :false-value=\"0\"\n                        size=\"large\"\n                      >\n                        <span slot=\"open\">开启</span>\n                        <span slot=\"close\">关闭</span>\n                      </i-switch>\n                    </FormItem>\n                    <FormItem label=\"广告时间:\">\n                      <InputNumber\n                        :min=\"0\"\n                        v-model=\"formItem.time\"\n                        placeholder=\"请输入开屏广告时间\"\n                        style=\"width: 150px\"\n                      />\n                      （单位：秒）\n                    </FormItem>\n                    <FormItem label=\"展示间隔:\">\n                      <InputNumber\n                        :min=\"0\"\n                        v-model=\"formItem.interval_time\"\n                        placeholder=\"请输入展示间隔时间\"\n                        style=\"width: 150px\"\n                      />\n                      （单位：小时）\n                    </FormItem>\n                  </Form>\n                </div>\n                <draggable\n                  class=\"dragArea list-group\"\n                  :list=\"tabList.list\"\n                  group=\"peoples\"\n                  handle=\".move-icon\"\n                >\n                  <div\n                    class=\"item\"\n                    v-for=\"(item, index) in tabList.list\"\n                    :key=\"index\"\n                  >\n                    <div class=\"move-icon\">\n                      <span class=\"iconfont icondrag2\"></span>\n                    </div>\n                    <div class=\"img-box\" @click=\"modalPicTap('单选', index)\">\n                      <img :src=\"item.img\" alt=\"\" v-if=\"item.img\" />\n                      <div class=\"upload-box\" v-else>\n                        <Icon type=\"ios-camera-outline\" size=\"36\" />\n                      </div>\n                      <div\n                        class=\"delect-btn\"\n                        @click.stop=\"bindDelete(item, index)\"\n                      >\n                        <Icon type=\"md-close-circle\" size=\"26\" />\n                      </div>\n                    </div>\n                    <div class=\"info\">\n                      <div class=\"info-item\">\n                        <span>图片名称：</span>\n                        <div class=\"input-box\">\n                          <Input\n                            v-model=\"item.comment\"\n                            placeholder=\"请填写名称\"\n                          />\n                        </div>\n                      </div>\n                      <div class=\"info-item\">\n                        <span>链接地址：</span>\n                        <div class=\"input-box\">\n                          <Input\n                            v-model=\"item.link\"\n                            icon=\"ios-link\"\n                            @on-click=\"link(index)\"\n                            search\n                            placeholder=\"选择链接\"\n                          />\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </draggable>\n                <div>\n                  <Modal\n                    v-model=\"modalPic\"\n                    width=\"960px\"\n                    scrollable\n                    footer-hide\n                    closable\n                    title=\"上传商品图\"\n                    :mask-closable=\"false\"\n                    :z-index=\"999\"\n                  >\n                    <uploadPictures\n                      :isChoice=\"isChoice\"\n                      @getPic=\"getPic\"\n                      :gridBtn=\"gridBtn\"\n                      :gridPic=\"gridPic\"\n                      v-if=\"modalPic\"\n                    ></uploadPictures>\n                  </Modal>\n                </div>\n              </div>\n              <template>\n                <div class=\"add-btn\">\n                  <Button ghost class=\"btn-add\" @click=\"addBox\"\n                    >添加图片</Button\n                  >\n                </div>\n              </template>\n            </div>\n          </div>\n        </div>\n      </Col>\n    </Row>\n  </Card>\n  <Card\n    :bordered=\"false\"\n    dis-hover\n    class=\"fixed-card\"\n    :style=\"{ left: `${!menuCollapse ? '200px' : isMobile ? '0' : '80px'}` }\"\n  >\n    <div class=\"acea-row row-center-wrapper\">\n      <Button class=\"bnt\" type=\"primary\" @click=\"save\" :loading=\"loadingExist\"\n        >保存</Button\n      >\n    </div>\n  </Card>\n  <linkaddress ref=\"linkaddres\" @linkUrl=\"linkUrl\"></linkaddress>\n</div>\n",null]}