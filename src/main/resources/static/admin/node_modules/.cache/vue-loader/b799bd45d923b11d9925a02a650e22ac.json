{"remainingRequest":"/home/ubuntu/repos/crmeb-java/src/main/resources/static/admin/node_modules/vue-loader/lib/index.js??vue-loader-options!/home/ubuntu/repos/crmeb-java/src/main/resources/static/admin/node_modules/iview-loader/index.js??ref--0-2!/home/ubuntu/repos/crmeb-java/src/main/resources/static/admin/src/components/settingGuide/wechat.vue?vue&type=template&id=543a4cae&scoped=true","dependencies":[{"path":"/home/ubuntu/repos/crmeb-java/src/main/resources/static/admin/src/components/settingGuide/wechat.vue","mtime":1736756303421},{"path":"/home/ubuntu/repos/crmeb-java/src/main/resources/static/admin/node_modules/cache-loader/dist/cjs.js","mtime":1736756398481},{"path":"/home/ubuntu/repos/crmeb-java/src/main/resources/static/admin/node_modules/babel-loader/lib/index.js","mtime":1736756399637},{"path":"/home/ubuntu/repos/crmeb-java/src/main/resources/static/admin/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1736756376821},{"path":"/home/ubuntu/repos/crmeb-java/src/main/resources/static/admin/node_modules/cache-loader/dist/cjs.js","mtime":1736756398481},{"path":"/home/ubuntu/repos/crmeb-java/src/main/resources/static/admin/node_modules/vue-loader/lib/index.js","mtime":1736756376753},{"path":"/home/ubuntu/repos/crmeb-java/src/main/resources/static/admin/node_modules/iview-loader/index.js","mtime":1736756399921}],"contextDependencies":[],"result":["\n<Tabs value=\"1\" :animated=\"false\">\n  <TabPane label=\"1.注册公众号\" name=\"1\">\n    <Timeline>\n      <TimelineItem>\n        <div class=\"dot\" slot=\"dot\">1</div>\n        <div class=\"title\">打开公众平台</div>\n        <div class=\"content\">\n          <div class=\"item\">\n            <div class=\"text\">\n              <div>\n                打开微信公众平台官网：<a\n                  href=\"https://mp.weixin.qq.com\"\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  >https://mp.weixin.qq.com</a\n                >\n              </div>\n              <div>右上角点击“立即注册”</div>\n            </div>\n            <div class=\"image\">\n              <img\n                :src=\"`${baseURL}/statics/system/wechat-1-1-1.png`\"\n                alt=\"\"\n              />\n            </div>\n          </div>\n        </div>\n      </TimelineItem>\n      <TimelineItem>\n        <div class=\"dot\" slot=\"dot\">2</div>\n        <div class=\"title\">选择账号类型：服务号</div>\n        <div class=\"content\">\n          <div class=\"item\">\n            <div class=\"text\">\n              <div>在选择注册账号类型中必须选择“服务号”</div>\n            </div>\n            <div class=\"image\">\n              <img\n                :src=\"`${baseURL}/statics/system/wechat-1-2-1.png`\"\n                alt=\"\"\n              />\n            </div>\n          </div>\n        </div>\n      </TimelineItem>\n      <TimelineItem>\n        <div class=\"dot\" slot=\"dot\">3</div>\n        <div class=\"title\">填写邮箱并激活</div>\n        <div class=\"content\">\n          <div class=\"item\">\n            <div class=\"text\">\n              <div>登录您的邮箱，查看激活邮件，然后在此填写邮箱验证码</div>\n            </div>\n            <div class=\"image\">\n              <img\n                :src=\"`${baseURL}/statics/system/wechat-1-3-1.png`\"\n                alt=\"\"\n              />\n            </div>\n          </div>\n        </div>\n      </TimelineItem>\n      <TimelineItem>\n        <div class=\"dot\" slot=\"dot\">4</div>\n        <div class=\"title\">信息登记</div>\n        <div class=\"content\">\n          <div class=\"item\">\n            <div class=\"text\">\n              <div>\n                公司请记得选择\n                企业→企业类型，之后的企业信息可根据您自己的企业情况填写\n              </div>\n            </div>\n            <div class=\"image\">\n              <img\n                :src=\"`${baseURL}/statics/system/wechat-1-4-1.png`\"\n                alt=\"\"\n              />\n            </div>\n          </div>\n        </div>\n      </TimelineItem>\n      <TimelineItem>\n        <div class=\"dot\" slot=\"dot\">5</div>\n        <div class=\"title\">填写公众号信息</div>\n        <div class=\"content\">\n          <div class=\"item\">\n            <div class=\"text\">\n              <div>填写公众号信息，包括帐号名称、功能介绍、选择运营地区</div>\n            </div>\n            <div class=\"image\">\n              <img\n                :src=\"`${baseURL}/statics/system/wechat-1-5-1.png`\"\n                alt=\"\"\n              />\n            </div>\n          </div>\n        </div>\n      </TimelineItem>\n      <TimelineItem>\n        <div class=\"dot\" slot=\"dot\">6</div>\n        <div class=\"title\">验证账号</div>\n        <div class=\"content\">\n          <div class=\"item\">\n            <div class=\"text\">\n              <div>根据所选择的验证方式，完成验证/认证后帐号功能即可使用</div>\n            </div>\n          </div>\n        </div>\n      </TimelineItem>\n    </Timeline>\n  </TabPane>\n  <TabPane label=\"2.公众号配置\" name=\"2\">\n    <Timeline>\n      <TimelineItem>\n        <div class=\"dot\" slot=\"dot\">1</div>\n        <div class=\"title\">登录公众平台</div>\n        <div class=\"content\">\n          <div class=\"item\">\n            <div class=\"text\">\n              <div>点击左侧菜单，设置→公众设置</div>\n            </div>\n            <div class=\"image\">\n              <img\n                :src=\"`${baseURL}/statics/system/wechat-2-1-1.png`\"\n                alt=\"\"\n              />\n            </div>\n          </div>\n        </div>\n      </TimelineItem>\n      <TimelineItem>\n        <div class=\"dot\" slot=\"dot\">2</div>\n        <div class=\"title\">功能设置中配置3个域名</div>\n        <div class=\"content\">\n          <div class=\"item\">\n            <div class=\"text\">\n              <div>\n                在功能设置中，配置“业务域名”、“JS接口安全域名”、“网页授权域名”\n              </div>\n            </div>\n            <div class=\"image\">\n              <img\n                :src=\"`${baseURL}/statics/system/wechat-2-2-1.png`\"\n                alt=\"\"\n              />\n            </div>\n          </div>\n        </div>\n      </TimelineItem>\n      <TimelineItem>\n        <div class=\"dot\" slot=\"dot\">3</div>\n        <div class=\"title\">配置域名</div>\n        <div class=\"content\">\n          <div class=\"item\">\n            <div class=\"text\">\n              <div>\n                配置域名，直接填写你所绑定配置的域名即可，填写域名的注意事项。\n              </div>\n            </div>\n            <Alert show-icon>\n              <div>注意事项：</div>\n              <div>1. 填写的域名不支持IP地址、端口号及短链域名；</div>\n              <div>2. 域名须通过<span>ICP备案</span></div>\n              <div>\n                3. 将验证文件上传至<span>public</span>下，并确保可以访问；\n              </div>\n              <div>4. 一个自然月内最多可修改并保存三次。</div>\n            </Alert>\n            <div class=\"image\">\n              <img\n                :src=\"`${baseURL}/statics/system/wechat-2-3-1.png`\"\n                alt=\"\"\n              />\n            </div>\n          </div>\n        </div>\n      </TimelineItem>\n      <TimelineItem>\n        <div class=\"dot\" slot=\"dot\">4</div>\n        <div class=\"title\">启用开发者密码</div>\n        <div class=\"content\">\n          <div class=\"item\">\n            <div class=\"text\">\n              <div>\n                点击左侧菜单开发→基本配置，点击启用开发者密码（AppSecret），根据提示进行验证\n              </div>\n            </div>\n            <div class=\"image\">\n              <img\n                :src=\"`${baseURL}/statics/system/wechat-2-4-1.png`\"\n                alt=\"\"\n              />\n              <img\n                :src=\"`${baseURL}/statics/system/wechat-2-4-2.png`\"\n                alt=\"\"\n              />\n            </div>\n          </div>\n        </div>\n      </TimelineItem>\n      <TimelineItem>\n        <div class=\"dot\" slot=\"dot\">5</div>\n        <div class=\"title\">保存记录AppID、AppSecret</div>\n        <div class=\"content\">\n          <div class=\"item\">\n            <div class=\"text\">\n              <div>本地最好新建一个 txt 文本文档，用于记录相关配置数据</div>\n            </div>\n            <div class=\"image\">\n              <img\n                :src=\"`${baseURL}/statics/system/wechat-2-5-1.png`\"\n                alt=\"\"\n              />\n            </div>\n          </div>\n        </div>\n      </TimelineItem>\n      <TimelineItem>\n        <div class=\"dot\" slot=\"dot\">6</div>\n        <div class=\"title\">选择是否设置白名单</div>\n        <div class=\"content\">\n          <div class=\"item\">\n            <div class=\"text\">\n              <div>1.关闭白名单，无需做其他配置</div>\n            </div>\n            <div class=\"image\">\n              <img\n                :src=\"`${baseURL}/statics/system/wechat-2-6-1.png`\"\n                alt=\"\"\n              />\n            </div>\n          </div>\n          <div class=\"item\">\n            <div class=\"text\">\n              <div>2.开启白名单，需要同时配置IP白名单</div>\n            </div>\n            <div class=\"image\">\n              <img\n                :src=\"`${baseURL}/statics/system/wechat-2-6-2.png`\"\n                alt=\"\"\n              />\n            </div>\n          </div>\n        </div>\n      </TimelineItem>\n    </Timeline>\n  </TabPane>\n  <TabPane label=\"3.开发配置\" name=\"3\">\n    <Timeline>\n      <TimelineItem>\n        <div class=\"dot\" slot=\"dot\">1</div>\n        <div class=\"title\">登录您的CRMEB系统后台</div>\n        <div class=\"content\">\n          <div class=\"item\">\n            <div class=\"text\">\n              <div>\n                点击设置→应用设置→公众号→基础配置，填写公众号开发者信息，AppID、AppSecret\n              </div>\n            </div>\n            <div class=\"image\">\n              <img\n                :src=\"`${baseURL}/statics/system/wechat-3-1-1.png`\"\n                alt=\"\"\n              />\n            </div>\n          </div>\n        </div>\n      </TimelineItem>\n      <TimelineItem>\n        <div class=\"dot\" slot=\"dot\">2</div>\n        <div class=\"title\">服务器配置（商城后台）</div>\n        <div class=\"content\">\n          <div class=\"item\">\n            <div class=\"text\">\n              <div>\n                随机生成\n                EncodingAESKey、微信验证TOKEN，消息加解密方式选择“明文模式”，完成后一定要点击“提交”\n              </div>\n            </div>\n            <div class=\"image\">\n              <img\n                :src=\"`${baseURL}/statics/system/wechat-3-2-1.png`\"\n                alt=\"\"\n              />\n            </div>\n          </div>\n        </div>\n      </TimelineItem>\n      <TimelineItem>\n        <div class=\"dot\" slot=\"dot\">3</div>\n        <div class=\"title\">服务器配置（微信公众平台）</div>\n        <div class=\"content\">\n          <div v-for=\"item in list\" :key=\"item\" class=\"item\">\n            <div v-for=\"txt in item.text\" class=\"text\">\n              <div :key=\"txt\" v-html=\"txt\"></div>\n            </div>\n            <Alert v-if=\"item.alert.length\" show-icon>\n              <div>注意事项：</div>\n              <div v-for=\"alt in item.alert\">\n                <div v-html=\"alt\"></div>\n              </div>\n            </Alert>\n            <div class=\"image\">\n              <img v-for=\"img in item.image\" :src=\"`${baseURL}/statics/system/${item.image}`\" alt=\"\" />\n            </div>\n          </div>\n        </div>\n      </TimelineItem>\n    </Timeline>\n  </TabPane>\n</Tabs>\n",null]}