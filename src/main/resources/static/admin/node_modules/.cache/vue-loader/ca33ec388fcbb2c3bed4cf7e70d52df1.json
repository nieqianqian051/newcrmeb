nput-add\"\n              ></Input>\n              <Button type=\"primary\" @click=\"hotSearchs\">查询</Button>\n            </FormItem>\n          </Col>\n        </Row>\n      </Form>\n    </div>\n  </Card>\n  <Card :bordered=\"false\" dis-hover class=\"ivu-mt\">\n    <!-- 相关操作 -->\n    <Row type=\"flex\">\n      <Col v-bind=\"grid\">\n        <Button type=\"primary\" @click=\"add\">添加热词</Button>\n      </Col>\n    </Row>\n    <!-- 保障服务表格 -->\n    <Table\n        :columns=\"columns1\"\n        :data=\"list\"\n        ref=\"table\"\n        class=\"mt25\"\n        :loading=\"loading\"\n        highlight-row\n        no-userFrom-text=\"暂无数据\"\n        no-filtered-userFrom-text=\"暂无筛选结果\"\n    >\n      <template slot-scope=\"{row, index}\" slot=\"name\">\n        <div class=\"words_tag\" :style=\"{ backgroundColor: row.bg_color, color: row.color,border: row.border_color ? '1px solid ' + row.border_color : 'none'  }\">\n          <img v-if=\"row.icon\" :src=\"row.icon\" alt=\"\" />\n          <span>{{ row.name }}</span>\n        </div>\n      </template>\n      <template slot-scope=\"{ row, index }\" slot=\"is_show\">\n        <i-switch\n            v-model=\"row.is_show\"\n            :true-value=\"1\"\n            :false-value=\"0\"\n            size=\"large\"\n            @on-change=\"showBnt(row)\"\n        >\n          <span slot=\"open\">开启</span>\n          <span slot=\"close\">关闭</span>\n        </i-switch>\n      </template>\n      <template slot-scope=\"{ row, index }\" slot=\"action\">\n        <a @click=\"edit(row.id)\">编辑</a>\n        <Divider type=\"vertical\" />\n        <a @click=\"del(row, '删除热词', index)\">删除</a>\n      </template>\n    </Table>\n    <div class=\"acea-row row-right page\">\n      <Page\n          :total=\"total\"\n          show-elevator\n          show-total\n          @on-change=\"pageChange\"\n          :page-size=\"hotWordsForm.limit\"\n      />\n    </div>\n  </Card>\n  <Modal v-model=\"modals\"\n         @on-cancel=\"cancel\"\n         @on-ok=\"addWordsConfirm\"\n         closable\n         title=\"添加热词\"\n         :mask-closable=\"false\"\n         :z-index=\"10\"\n         width=\"560\"\n         @submit.native.prevent>\n    <div>\n      <Form size=\"small\" ref=\"form\" :rules=\"rules\" :model=\"form\" :label-width=\"100\">\n        <FormItem label=\"热词名称：\" prop=\"name\">\n          <Input v-model=\"form.name\" class=\"w-420\"></Input>\n        </FormItem>\n        <FormItem label=\"高级设置：\">\n          <i-switch v-model=\"form.is_search\" :true-value=\"1\" :false-value=\"0\" size=\"large\">\n            <span slot=\"open\">开启</span>\n            <span slot=\"close\">关闭</span>\n          </i-switch>\n        </FormItem>\n        <FormItem label=\"字体颜色：\" v-if=\"form.is_search\">\n          <ColorPicker v-model=\"form.color\" alpha ></ColorPicker>\n          <p class=\"desc\">若未设置颜色，则为默认色</p>\n        </FormItem>\n        <FormItem label=\"背景颜色：\" v-if=\"form.is_search\">\n          <ColorPicker v-model=\"form.bg_color\" alpha ></ColorPicker>\n          <p class=\"desc\">若未设置颜色，则为默认色</p>\n        </FormItem>\n        <FormItem label=\"边框颜色：\" v-if=\"form.is_search\">\n          <ColorPicker v-model=\"form.border_color\" alpha ></ColorPicker>\n          <p class=\"desc\">若未设置颜色，则无边框</p>\n        </FormItem>\n        <FormItem label=\"上传图标\" v-if=\"form.is_search\">\n          <div v-if=\"form.icon\" class=\"upload-list\">\n            <div class=\"upload-item\">\n              <img :src=\"form.icon\" />\n              <Button\n                  shape=\"circle\"\n                  icon=\"ios-close\"\n                  @click=\"delImage\"\n              ></Button>\n            </div>\n          </div>\n          <Button\n              v-else\n              class=\"upload-select\"\n              type=\"dashed\"\n              icon=\"ios-add\"\n              @click=\"modalPicTap('dan', 'image', 1)\"\n          ></Button>\n          <p class=\"desc\">建议尺寸：32px*32px，若未上传则只展示文字</p>\n        </FormItem>\n        <FormItem label=\"排序\">\n          <InputNumber\n              v-model=\"form.sort\"\n              :min=\"0\"\n              :max=\"999\"\n              class=\"selWidth\"\n          ></InputNumber>\n        </FormItem>\n        <FormItem label=\"是否开启：\">\n          <i-switch v-model=\"form.is_show\" :true-value=\"1\" :false-value=\"0\" size=\"large\">\n            <span slot=\"open\">开启</span>\n            <span slot=\"close\">关闭</span>\n          </i-switch>\n        </FormItem>\n      </Form>\n    </div>\n  </Modal>\n  <Modal\n      v-model=\"modalPic\"\n      width=\"960px\"\n      scrollable\n      footer-hide\n      closable\n      title=\"上传图标\"\n      :mask-closable=\"false\"\n      :z-index=\"500\"\n  >\n    <uploadPictures\n        isChoice=\"单选\"\n        @getPic=\"getPic\"\n        v-if=\"modalPic\"\n    ></uploadPictures>\n  </Modal>\n</div>\n",null]}