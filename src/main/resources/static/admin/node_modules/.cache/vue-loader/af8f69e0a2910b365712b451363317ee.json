ard :bordered=\"false\" dis-hover class=\"ivu-mt\" :padding=\"0\">\n       <div class=\"new_card_pd\">\n        <!-- 筛选条件 -->\n         <Form\n        ref=\"formValidate\"\n        inline\n        :model=\"formValidate\"\n        :label-width=\"labelWidth\"\n        :label-position=\"labelPosition\"\n        @submit.native.prevent\n      >\n            <FormItem label=\"时间选择：\">\n              <DatePicker\n                :editable=\"false\"\n                @on-change=\"onchangeTime\"\n                :value=\"timeVal\"\n                format=\"yyyy/MM/dd\"\n               type=\"datetimerange\"\n              placement=\"bottom-start\"\n              placeholder=\"自定义时间\"\n              class=\"input-width\"\n              :options=\"options\"\n              ></DatePicker>\n            </FormItem>\n\n            <FormItem label=\"评价状态：\">\n              <Select\n                v-model=\"formValidate.is_reply\"\n                placeholder=\"请选择\"\n                clearable\n                @on-change=\"userSearchs\"\n                class=\"input-add\"\n              >\n                <Option value=\"1\">已回复</Option>\n                <Option value=\"0\">待回复</Option>\n              </Select>\n            </FormItem>\n\n            <FormItem label=\"商品信息：\" label-for=\"store_name\">\n              <Input\n                size=\"default\"\n                enter-button\n                placeholder=\"请输入商品ID或者商品信息\"\n                clearable\n                v-model=\"formValidate.store_name\"\n                class=\"input-add\"\n              />\n            </FormItem>\n\n            <FormItem label=\"用户名称：\" label-for=\"account\">\n              <Input\n                size=\"default\"\n                enter-button\n                placeholder=\"请输入\"\n                clearable\n                v-model=\"formValidate.account\"\n                class=\"input-add\"\n              />\n            </FormItem>\n            <Button type=\"primary\" @click=\"userSearchs\">查询</Button>\n      </Form>\n       </div>\n     </Card>\n\n    <Card :bordered=\"false\" dis-hover class=\"ivu-mt\">\n      <!-- 相关操作 -->\n      <Row type=\"flex\">\n        <Col v-bind=\"grid\">\n          <Button\n            v-auth=\"['product-reply-save_fictitious_reply']\"\n            type=\"primary\"\n            @click=\"add\"\n            >添加自评</Button\n          >\n        </Col>\n      </Row>\n      <!-- 商品评论表格 -->\n      <Table\n        ref=\"table\"\n        :columns=\"columns\"\n        :data=\"tableList\"\n        class=\"ivu-mt\"\n        :loading=\"loading\"\n        no-data-text=\"暂无数据\"\n        no-filtered-data-text=\"暂无筛选结果\"\n      >\n        <template slot-scope=\"{ row }\" slot=\"info\">\n          <div class=\"imgPic acea-row row-middle\">\n            <viewer>\n              <div class=\"pictrue\"><img v-lazy=\"row.image\" /></div>\n            </viewer>\n            <div class=\"info line2\">{{ row.store_name }}</div>\n          </div>\n        </template>\n        <template slot-scope=\"{ row }\" slot=\"content\">\n          <div class=\"mb5 content_font\">{{ row.comment }}</div>\n          <viewer>\n            <div\n              class=\"pictrue mr10\"\n              v-for=\"(item, index) in row.pics || []\"\n              :key=\"index\"\n            >\n              <img v-lazy=\"item\" />\n            </div>\n          </viewer>\n        </template>\n        <template slot-scope=\"{row}\" slot=\"reply_score\">\n          <span v-if=\"row.reply_score === 3\">好评</span>\n          <span v-else-if=\"row.reply_score === 2\">中评</span>\n          <span v-else>差评</span>\n        </template>\n        <template slot-scope=\"{ row }\" slot=\"reply\">\n          <Tooltip max-width=\"200\" placement=\"bottom\">\n            <span class=\"line2\">{{row.replyComment?row.replyComment.content:''}}</span>\n            <p slot=\"content\">{{row.replyComment?row.replyComment.content:''}}</p>\n          </Tooltip>\n        </template>\n        <template slot-scope=\"{ row, index }\" slot=\"action\">\n\t\t\t\t\t<a @click=\"seeReply(row)\">查看</a>\n\t\t\t\t\t<Divider type=\"vertical\" />\n          <a @click=\"reply(row)\">回复</a>\n          <Divider type=\"vertical\" />\n          <a @click=\"del(row, '删除评论', index)\">删除</a>\n        </template>\n      </Table>\n      <div class=\"acea-row row-right page\">\n        <Page\n          :total=\"total\"\n          :current=\"formValidate.page\"\n          show-elevator\n          show-total\n          @on-change=\"pageChange\"\n          :page-size=\"formValidate.limit\"\n        />\n      </div>\n    </Card>\n    <Modal v-model=\"modals\" scrollable title=\"回复内容\" closable>\n      <Form\n        ref=\"contents\"\n        :model=\"contents\"\n        :rules=\"ruleInline\"\n        :label-position=\"labelPosition\"\n        @submit.native.prevent\n      >\n        <FormItem prop=\"content\">\n          <Input\n            v-model=\"contents.content\"\n            type=\"textarea\"\n            :rows=\"4\"\n            placeholder=\"请输入回复内容\"\n          />\n        </FormItem>\n      </Form>\n      <div slot=\"footer\">\n        <Button type=\"primary\" @click=\"oks\">确定</Button>\n        <Button @click=\"cancels\">取消</Button>\n      </div>\n    </Modal>\n\t<!-- \t<storeList ref=\"store\" @getStoreId=\"getStoreId\" @getUserInfo='getUserInfo'></storeList> -->\n\t\t<replyList ref=\"reply\"></replyList>\n    <addReply\n      :visible.sync=\"replyModal\"\n      :goods=\"goodsData\"\n      :attr=\"attrData\"\n      :avatar=\"avatarData\"\n      :picture=\"pictureData\"\n      @callGoods=\"callGoods\"\n      @callAttr=\"callAttr\"\n      @callPicture=\"callPicture\"\n      @removePicture=\"removePicture\"\n    ></addReply>\n    <Modal v-model=\"goodsModal\" title=\"选择商品\" width=\"960\" scrollable footer-hide>\n      <goodsList v-if=\"replyModal\" :goods-type=\"0\" @getProductId=\"getProductId\"></goodsList>\n    </Modal>\n    <Modal v-model=\"attrModal\" title=\"选择商品规格\" width=\"960\" scrollable footer-hide>\n      <Table :columns=\"tableColumns\" :data=\"goodsData.attrValue\" height=\"500\">\n        <template slot-scope=\"{ row, index }\" slot=\"image\">\n          <div class=\"product-data\">\n            <img class=\"image\" :src=\"row.image\" />\n          </div>\n        </template>\n      </Table>\n    </Modal>\n    <Modal\n        v-model=\"pictureModal\"\n        width=\"960px\"\n        scrollable\n        footer-hide\n        closable\n        title=\"上传商品图\"\n        :mask-closable=\"false\"\n        :z-index=\"1\"\n      >\n        <uploadPictures\n          :isChoice=\"isChoice\"\n          @getPic=\"getPic\"\n          @getPicD=\"getPicD\"\n          :gridBtn=\"gridBtn\"\n          :gridPic=\"gridPic\"\n          v-if=\"pictureModal\"\n        ></uploadPictures>\n      </Modal>\n  </div>\n",null]}