  <Radio label=\"3\">无需配送</Radio>\n      </RadioGroup>\n    </FormItem>\n    <FormItem\n      v-if=\"formItem.type == 1\"\n      v-show=\"export_open\"\n      label=\"发货类型：\"\n    >\n      <RadioGroup\n        v-model=\"formItem.express_record_type\"\n        @on-change=\"changeExpress\"\n      >\n        <Radio label=\"3\">商家寄件</Radio>\n        <Radio label=\"1\">手动填写</Radio>\n        <Radio label=\"2\">电子面单打印</Radio>\n      </RadioGroup>\n    </FormItem>\n    <template\n      v-if=\"\n        ['2', '3'].includes(formItem.express_record_type) &&\n          formItem.type == 1\n      \"\n    >\n      <FormItem label=\"寄件人姓名：\">\n        <Input\n          v-model=\"formItem.to_name\"\n          placeholder=\"请输入寄件人姓名\"\n          class=\"input-add\"\n        ></Input>\n      </FormItem>\n      <FormItem label=\"寄件人电话：\">\n        <Input\n          v-model=\"formItem.to_tel\"\n          placeholder=\"请输入寄件人电话\"\n          class=\"input-add\"\n        ></Input>\n      </FormItem>\n      <FormItem label=\"寄件人地址：\">\n        <Input\n          v-model=\"formItem.to_addr\"\n          placeholder=\"请输入寄件人地址\"\n          class=\"input-add\"\n        ></Input>\n      </FormItem>\n    </template>\n    <div>\n      <FormItem label=\"快递公司：\" required v-if=\"formItem.type == 1\">\n        <Select\n          v-model=\"formItem.delivery_name\"\n          filterable\n          placeholder=\"请选择快递公司\"\n          class=\"input-add\"\n          @on-change=\"expressChange\"\n        >\n          <Option\n            v-for=\"item in formItem.express_record_type == 3\n              ? kuaidiExpress\n              : express\"\n            :value=\"item.value\"\n            :key=\"item.value\"\n            >{{ item.value }}\n          </Option>\n        </Select>\n      </FormItem>\n      <FormItem\n        label=\"快递业务类型：\"\n        required\n        v-if=\"formItem.type == 1 && formItem.express_record_type == 3\"\n      >\n        <Select\n          v-model=\"formItem.service_type\"\n          filterable\n          placeholder=\"请选择业务类型\"\n          class=\"input-add\"\n          @on-change=\"watchPrice\"\n        >\n          <Option v-for=\"item in serviceTypeList\" :value=\"item\" :key=\"item\"\n            >{{ item }}\n          </Option>\n        </Select>\n      </FormItem>\n      <FormItem\n        v-if=\"formItem.express_record_type === '1' && formItem.type == 1\"\n        label=\"快递单号：\"\n        required\n      >\n        <Input\n          v-model=\"formItem.delivery_id\"\n          placeholder=\"请输入快递单号\"\n          class=\"input-add\"\n        ></Input>\n        <div class=\"trips\" v-if=\"formItem.delivery_name == '顺丰速运'\">\n          <p>顺丰请输入单号 :收件人或寄件人手机号后四位，</p>\n          <p>例如：SF000000000000:3941</p>\n        </div>\n      </FormItem>\n      <template\n        v-if=\"\n          ['2', '3'].includes(formItem.express_record_type) &&\n            formItem.type === '1'\n        \"\n      >\n        <FormItem label=\"电子面单：\" class=\"express_temp_id\">\n          <Select\n            v-model=\"formItem.express_temp_id\"\n            placeholder=\"请选择电子面单\"\n            class=\"input-add\"\n            @on-change=\"expressTempChange\"\n          >\n            <Option\n              v-for=\"(item, i) in expressTemp\"\n              :value=\"item.temp_id\"\n              :key=\"i\"\n              >{{ item.title }}\n            </Option>\n          </Select>\n          <Button v-if=\"formItem.express_temp_id\" type=\"text\" @click=\"preview\"\n            >预览\n          </Button>\n        </FormItem>\n        <template v-if=\"formItem.express_record_type == 3\">\n          <FormItem label=\"预计寄件金额：\">\n            <span class=\"red\">{{ sendPrice }}</span>\n            <Button type=\"text\" size=\"small\" @click=\"watchPrice\"\n              >立即计算</Button\n            >\n          </FormItem>\n          <FormItem label=\"取件日期：\">\n            <RadioGroup v-model=\"formItem.day_type\">\n              <Radio :label=\"0\">今天</Radio>\n           