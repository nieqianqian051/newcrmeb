me=\"3\" />\n      <TabPane label=\"已核销\" name=\"6\" />\n      <TabPane label=\"已完成\" name=\"4\" />\n      <TabPane label=\"已退款\" name=\"-2\" />\n    </Tabs>\n  </div>\n  <div class=\"acea-row row-between\">\n    <!-- 相关操作 -->\n    <div>\n      <Tooltip\n        content=\"本页至少选中一项\"\n        :disabled=\"!!checkUidList.length && isAll == 0\"\n        v-auth=\"['order-batch-del_orders']\"\n      >\n        <Button\n          class=\"mr10\"\n          type=\"primary\"\n          :disabled=\"!checkUidList.length && isAll == 0\"\n          @click=\"delAll\"\n          >批量删除订单</Button\n        >\n      </Tooltip>\n      <Button\n        class=\"mr10\"\n        v-auth=\"['order-hand-batch_delivery']\"\n        type=\"primary\"\n        @click=\"manualModal = true\"\n        >手动批量发货</Button\n      >\n      <Tooltip\n        content=\"本页至少选中一项\"\n        :disabled=\"!!checkUidList.length && isAll == 0\"\n        v-auth=\"['order-other-batch_delivery']\"\n      >\n        <Button\n          class=\"mr10\"\n          type=\"primary\"\n          :disabled=\"!checkUidList.length && isAll == 0\"\n          @click=\"onAuto\"\n          >自动批量发货</Button\n        >\n      </Tooltip>\n      <Tooltip\n        content=\"本页至少选中一项\"\n        :disabled=\"!!checkUidList.length && isAll == 0\"\n      >\n        <Button\n          class=\"mr10\"\n          type=\"primary\"\n          :disabled=\"!checkUidList.length && isAll == 0\"\n          @click=\"printOreder\"\n          >打印配货单</Button\n        >\n      </Tooltip>\n      <Dropdown\n        v-auth=\"['export-storeOrder']\"\n        class=\"mr10\"\n        @on-click=\"exports\"\n      >\n        <Button style=\"width: 110px\">\n          {{ exportList[exportListOn].label }}\n          <Icon type=\"ios-arrow-down\"></Icon>\n        </Button>\n        <DropdownMenu slot=\"list\">\n          <DropdownItem\n            v-for=\"(item, index) in exportList\"\n            :key=\"index\"\n            :name=\"item.name\"\n            style=\"font-size: 12px !important\"\n            >{{ item.label }}</DropdownItem\n          >\n        </DropdownMenu>\n      </Dropdown>\n      <Button\n        v-auth=\"['order-write']\"\n        class=\"mr10 greens\"\n        size=\"default\"\n        :disabled=\"!checkUidList.length\"\n        @click=\"writeOff\"\n        >订单核销</Button\n      >\n    </div>\n    <div class=\"caozuo\">\n      <Button v-auth=\"['queue-index']\" class=\"mr10\" @click=\"queuemModal\"\n        >批量发货记录</Button\n      >\n      <Button\n        v-auth=\"['export-expressList']\"\n        class=\"mr10\"\n        @click=\"getExpressList\"\n        >下载物流公司对照表</Button\n      >\n    </div>\n  </div>\n  <!-- 订单列表表格 -->\n  <vxe-table\n    ref=\"xTable\"\n    class=\"mt25\"\n    :loading=\"loading\"\n    row-id=\"id\"\n    :expand-config=\"{ accordion: true }\"\n    :checkbox-config=\"{ reserve: true }\"\n    @checkbox-all=\"checkboxAll\"\n    @checkbox-change=\"checkboxItem\"\n    :data=\"orderList\"\n  >\n    <vxe-column type=\"\" width=\"0\"></vxe-column>\n    <vxe-column type=\"expand\" width=\"35\">\n      <template #content=\"{ row }\">\n        <div class=\"tdinfo\">\n          <Row class=\"expand-row\">\n            <Col span=\"8\">\n              <span class=\"expand-key\">商品总价：</span>\n              <span class=\"expand-value\" v-text=\"row.total_price\"></span>\n            </Col>\n            <Col span=\"8\">\n              <span class=\"expand-key\">下单时间：</span>\n              <span class=\"expand-value\" v-text=\"row.add_time\"></span>\n            </Col>\n            <Col span=\"8\">\n              <span class=\"expand-key\">推广人：</span>\n              <span\n                class=\"expand-value\"\n                v-text=\"row.spread_nickname ? row.spread_nickname : '无'\"\n              ></span>\n            </Col>\n          </Row>\n          <Row class=\"expand-row\">\n            <Col span=\"8\">\n              <span class=\"expand-key\">用户备注：</span>\n              <span\n                class=\"expand-value\"\n                v-text=\"row.mark ? row.mark : '无'\"\n              ></span>\n            </Col>\n            <Col span=\"8\">\n              <span class=\"expand-key\">商家备注：</span>\n              <span\n                class=\"expand-value\"\n                v-text=\"row.remark ? row.remark : '无'\"\n              ></span>\n            </Col>\n            <Col span=\"8\">\n              <span class=\"expand-key\">供应商名称：</span>\n              <span\n                class=\"expand-value\"\n                v-text=\"row.supplier_name || '--'\"\n              ></span>\n            </Col>\n          </Row>\n        </div>\n      </template>\n    </vxe-column>\n    <vxe-column type=\"checkbox\" width=\"100\">\n      <template #header>\n        <div>\n          <Dropdown transfer @on-click=\"allPages\">\n            <a href=\"javascript:void(0)\" class=\"acea-row row-middle\">\n              <span\n                >全选({{\n                  isAll == 1\n                    ? page.total - checkUidList.length\n                    : checkUidList.length\n                }})</span\n              >\n              <Icon type=\"ios-arrow-down\"></Icon>\n            </a>\n            <template #list>\n              <DropdownMenu>\n                <DropdownItem name=\"0\">当前页</DropdownItem>\n                <DropdownItem name=\"1\">所有页</DropdownItem>\n              </DropdownMenu>\n            </template>\n          </Dropdown>\n        </div>\n      </template>\n    </vxe-column>\n    <vxe-column field=\"order_id\" title=\"订单号\" min-width=\"175\">\n      <template v-slot=\"{ row }\">\n        <Tooltip\n          :transfer=\"true\"\n          theme=\"dark\"\n          max-width=\"300\"\n          :delay=\"600\"\n          content=\"用户已删除\"\n          v-if=\"row.is_del === 1 && row.delete_time == null\"\n        >\n          <span style=\"color: #ed4014; display: block\">{{\n            row.order_id\n          }}</span>\n        </Tooltip>\n        <span\n          @click=\"changeMenu(row, '2')\"\n          v-else\n          style=\"color: #2d8cf0; display: block; cursor: pointer\"\n          >{{ row.order_id }}</span\n        >\n      </template>\n    </vxe-column>\n    <vxe-column\n      field=\"pink_name\"\n      title=\"活动类型\"\n      min-width=\"120\"\n    ></vxe-column>\n    <vxe-column field=\"nickname\" title=\"用户信息\" min-width=\"130\">\n      <template v-slot=\"{ row }\">\n        <a @click=\"showUserInfo(row)\">{{ row.nickname }}</a>\n        <span style=\"color: #ed4014\" v-if=\"row.delete_time != null\">\n          (已注销)</span\n        >\n      </template>\n    </vxe-column>\n    <vxe-column field=\"info\" title=\"商品信息\" min-width=\"330\">\n      <template v-slot=\"{ row }\">\n        <Tooltip :transfer=\"true\" theme=\"dark\" max-width=\"300\" :delay=\"600\">\n          <div class=\"tabBox\" v-for=\"(val, i) in row._info\" :key=\"i\">\n            <div class=\"tabBox_img\" v-viewer>\n              <img\n                v-lazy=\"\n                  val.cart_info.productInfo.attrInfo\n                    ? val.cart_info.productInfo.attrInfo.image\n                    : val.cart_info.productInfo.image\n                \"\n              />\n            </div>\n            <span class=\"tabBox_tit line1\">\n              <span class=\"font-color-red\" v-if=\"val.cart_info.is_gift\"\n                >赠品</span\n              >\n\n              {{ val.cart_info.productInfo.store_name + \" | \" }}\n              {{\n                val.cart_info.productInfo.attrInfo\n                  ? val.cart_info.productInfo.attrInfo.suk\n                  : \"\"\n              }}\n            </span>\n            <span>{{ \" x \" + val.cart_info.cart_num }}</span>\n          </div>\n          <div slot=\"content\">\n            <div v-for=\"(val, i) in row._info\" :key=\"i\">\n              <p class=\"font-color-red\" v-if=\"val.cart_info.is_gift\">赠品</p>\n              <p>{{ val.cart_info.productInfo.store_name }}</p>\n              <p>\n                {{\n                  val.cart_info.productInfo.attrInfo\n                    ? val.cart_info.productInfo.attrInfo.suk\n                    : \"\"\n                }}\n              </p>\n              <p class=\"tabBox_pice\">\n                {{\n                  \"￥\" +\n                    val.cart_info.sum_price +\n                    \" x \" +\n                    val.cart_info.cart_num\n                }}\n              </p>\n            </div>\n          </div>\n        </Tooltip>\n      </template>\n    </vxe-column>\n    <vxe-column\n      field=\"pay_price\"\n      title=\"实际支付\"\n      align=\"center\"\n      min-width=\"70\"\n    >\n      <template v-slot=\"{ row }\">\n        <span>{{ row.paid > 0 ? row.pay_price : 0 }}</span>\n      </template>\n    </vxe-column>\n    <vxe-column\n      field=\"_pay_time\"\n      title=\"支付时间\"\n      min-width=\"150\"\n    ></vxe-column>\n    <vxe-column field=\"pay_type_name\" title=\"支付类型\" min-width=\"100\">\n      <template v-slot=\"{ row }\">\n        <span>{{ row.pay_type_name }}</span>\n      </template>\n    </vxe-column>\n    <vxe-column field=\"mark\" title=\"备注\" min-width=\"120\">\n      <template v-slot=\"{ row }\">\n        <span>{{ row.mark || \"--\" }}</span>\n      </template>\n    </vxe-column>\n    <vxe-column field=\"remark\" title=\"商家备注\" min-width=\"120\">\n      <template v-slot=\"{ row }\">\n        <span>{{ row.remark || \"--\" }}</span>\n      </template>\n    </vxe-column>\n    <vxe-column field=\"statusName\" title=\"订单状态\" min-width=\"100\">\n      <template v-slot=\"{ row }\">\n        <Tag color=\"default\" size=\"medium\" v-show=\"row.status == 3\">{{\n          row.status_name.status_name\n        }}</Tag>\n        <Tag color=\"orange\" size=\"medium\" v-show=\"row.status == 4\">{{\n          row.status_name.status_name\n        }}</Tag>\n        <Tag\n          color=\"orange\"\n          size=\"medium\"\n          v-show=\"[1, 2, 5].includes(row.status)\"\n     